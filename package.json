{
  "name": "peerchive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": "^22.19.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "worker": "pnpm --filter worker dev",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @peerchive/db run generate",
    "db:migrate": "pnpm --filter @peerchive/db run migrate",
    "check:archive": "python3 scripts/check_archive.py"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
