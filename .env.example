# 로컬 개발 전용 값입니다. 실제 비밀값을 이 파일에 넣지 마세요.
# 사용: cp .env.example .env
POSTGRES_USER=peerchive
POSTGRES_PASSWORD=peerchive
POSTGRES_DB=peerchive
# 호스트 포트가 이미 사용 중이면 바꾸고 DATABASE_URL 포트도 함께 바꾸세요.
POSTGRES_PORT=5432
DATABASE_URL=postgres://peerchive:peerchive@localhost:5432/peerchive

# 웹앱 서버(apps/web). 로컬 전용 값입니다.
# 허용 사이트 origin(쉼표 구분). 첫 항목으로 로그인·초대 링크를 만들고 상태 변경 API의 Origin 검사에 씁니다.
NUXT_SITE_ORIGIN=http://localhost:3000
# 메일 transport. 'dev-console'은 로그인 링크를 서버 콘솔에 출력하는 개발 전용이며 production에서는 서버가 시작되지 않습니다.
# production은 PEERCHIVE_MAIL_TRANSPORT=smtp(우선) + 아래 SMTP 값만 허용합니다(ADR 0017).
NUXT_MAIL_TRANSPORT=dev-console
# 로컬 Mailpit으로 실제 SMTP 경로를 시험할 때(docker compose --profile mailpit). 아래 주석을 풀고 위 dev-console 대신 씁니다.
# PEERCHIVE_MAIL_TRANSPORT=smtp
# PEERCHIVE_SMTP_URL=smtp://127.0.0.1:1025
# 1이면 TLS 없는 SMTP 허용(Mailpit 전용). production에서는 서버가 시작되지 않습니다.
# PEERCHIVE_SMTP_ALLOW_INSECURE=1
# PEERCHIVE_MAIL_FROM=Peerchive <no-reply@peerchive.localhost>
# PEERCHIVE_MAIL_REPLY_TO=
# 운영 예(값은 비밀 저장소에): PEERCHIVE_SMTP_URL=smtps://<user>:<password>@<smtp host>:465 또는 smtp://…:587(STARTTLS 필수)
# Mailpit 호스트 포트(compose). 쓰이고 있으면 바꾸세요.
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# 파일 저장소·검사(apps/web, apps/worker 공통, ADR 0007). 로컬 전용 값입니다.
# 저장소 driver: filesystem 또는 s3(S3 호환, ADR 0017). production에서 filesystem은 허용 표시 없이는 시작하지 않습니다.
PEERCHIVE_STORAGE_DRIVER=filesystem
# 상대 경로면 저장소 루트 기준(.data/는 .gitignore 대상). 이 디렉터리를 정적 경로로 공개하지 마세요.
PEERCHIVE_STORAGE_ROOT=.data/objects
# 로컬 MinIO로 s3 driver를 시험할 때(docker compose --profile minio). 버킷은 MinIO 관리 화면(http://127.0.0.1:9001)에서 먼저 만듭니다.
# PEERCHIVE_STORAGE_DRIVER=s3
# PEERCHIVE_S3_ENDPOINT=http://127.0.0.1:9000
# PEERCHIVE_S3_REGION=us-east-1
# PEERCHIVE_S3_BUCKET=peerchive-dev
# PEERCHIVE_S3_ACCESS_KEY_ID=peerchive-local
# PEERCHIVE_S3_SECRET_ACCESS_KEY=peerchive-local-only
# PEERCHIVE_S3_FORCE_PATH_STYLE=1
# PEERCHIVE_S3_PREFIX=
# MinIO 로컬 전용 계정(compose)과 호스트 포트. 운영 값이 아닙니다.
MINIO_ROOT_USER=peerchive-local
MINIO_ROOT_PASSWORD=peerchive-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# 악성코드 검사기: signature-only(개발 전용, production 거부) 또는 clamav.
PEERCHIVE_MALWARE_SCANNER=signature-only
# clamav를 쓸 때(docker compose --profile clamav). 포트가 쓰이고 있으면 바꾸세요.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# 디스코드 봇 ↔ 웹 서버 내부 API(apps/bot, ADR 0009). 로컬 전용 값입니다.
# 웹 서버와 봇이 같은 값을 씁니다. 비워 두면 웹의 /api/internal이 꺼집니다(503).
# production에서는 이 자리표시 값으로 웹·봇이 시작되지 않습니다. 실제 값은 `openssl rand -hex 32`로 만들고 비밀 저장소에 두세요.
PEERCHIVE_INTERNAL_SECRET=local-dev-only-change-me-0123456789abcdef
# 봇이 부를 웹 서버 주소(개발 기본 http://localhost:3000)와 사용자에게 보여 줄 사이트 주소(기본: API 주소).
PEERCHIVE_API_BASE_URL=http://localhost:3000
# PEERCHIVE_SITE_URL=http://localhost:3000
# 디스코드 개발자 포털에서 받은 값(apps/bot/README.md). 저장소에 커밋하지 마세요.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# 명령을 한 서버에만 등록할 때(개발용, 즉시 반영). 비우면 전역 등록.
DISCORD_GUILD_ID=

# 공개 조회(T-12, ADR 0012). 1이면 /api/v1/public/** 전체를 503으로 막습니다(운영 스위치, 재시작 필요).
# PEERCHIVE_PUBLIC_READS_DISABLED=1
# 1이면 공개 페이지·공개 JSON의 noindex를 뺍니다(파일럿 기본은 noindex).
# PEERCHIVE_PUBLIC_INDEXING=1

# 운영(T-16, ADR 0016, docs/ops/RUNBOOK.md). 로컬 전용 값입니다.
# 1이면 web이 /api/v1/health 밖 모든 요청을 503으로 막습니다(복구 뒤 삭제 재적용 전까지).
# PEERCHIVE_MAINTENANCE=1
# 분석 이벤트·삭제 장부 HMAC pepper(서로 다른 값). 개발에서는 비워 두면 개발용 고정 값을 씁니다.
# production에서는 `openssl rand -hex 32`로 만들어 비밀 저장소에 두세요(없으면 분석은 꺼지고 worker는 시작하지 않음).
# 삭제 장부 pepper는 바꾸지 마세요(복구 뒤 재적용이 이전 장부를 맞추지 못함).
# PEERCHIVE_ANALYTICS_PEPPER=
# PEERCHIVE_DELETION_PEPPER=
# 탈퇴 요청 뒤 정리까지 유예 일수(기본 7), 주기 작업 일정(5필드 cron 또는 off, Asia/Seoul).
# PEERCHIVE_DELETION_GRACE_DAYS=7
# PEERCHIVE_CRON_ACCOUNT_PURGE=*/30 * * * *

# 프록시·로드밸런서 뒤에서만 설정합니다(쉼표 구분 CIDR, 예: 10.0.0.0/8,fd00::/8).
# 비워 두면 X-Forwarded-For를 무시하고 소켓 주소만 요청 한도 키로 씁니다.
PEERCHIVE_TRUSTED_PROXIES=
