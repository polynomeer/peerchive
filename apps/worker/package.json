{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Peerchive 작업 worker(pg-boss). 파일 검사, 공개 게시·철회 이벤트(검색 색인·유용성 신호 정리), 선배 노트 색인을 처리합니다.",
  "scripts": {
    "dev": "NODE_ENV=development tsx src/main.ts",
    "start": "tsx src/main.ts",
    "backfill-strip": "tsx src/backfill-strip.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@peerchive/db": "workspace:*",
    "@peerchive/domain": "workspace:*",
    "@peerchive/files": "workspace:*",
    "pg-boss": "12.36.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
