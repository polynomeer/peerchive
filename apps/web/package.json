    "@peerchive/domain": "workspace:*",
    "@peerchive/files": "workspace:*",
    "h3": "1.15.11",
    "nodemailer": "10.1.0",
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  }
}
